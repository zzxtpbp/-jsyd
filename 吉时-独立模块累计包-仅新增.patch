+// 只消费已验证的天气/路线数据，不查询接口、不写入闹钟。
+export function calculateSmartCandidate(options = {}) {
+  const { baseAlarmAt, arrivalAt, durationMinutes, preparation, buffer, extra,
+    maxAdvance, smartEnabled, weatherTriggered, validUntil, updatedAt, now } = options ?? {};
+  const isTime = value => Number.isSafeInteger(value) && Number.isFinite(new Date(value).getTime());
+  const result = {
+    baseAlarmAt: isTime(baseAlarmAt) ? baseAlarmAt : null,
+    wakeAt: null, desiredWakeAt: null, departAt: null, gapMinutes: null,
+    status: 'unavailable', source: 'smart', reason: '',
+    validUntil: null, updatedAt: null, executionState: 'suggested',
+  };
+  if (smartEnabled !== true) return { ...result, reason: '智能模式未开启或开关无效。' };
+  if (!isTime(now) || !isTime(baseAlarmAt) || !isTime(arrivalAt) || baseAlarmAt <= now || arrivalAt <= now) {
+    return { ...result, reason: '需要有效且尚未到期的基础及到达时间。' };
+  }
+  if (typeof weatherTriggered !== 'boolean') return { ...result, status: 'weather_unknown', reason: '天气触发结果未知。' };
+  if (!weatherTriggered) return { ...result, reason: '天气未达到触发条件。' };
+  if (!Number.isInteger(durationMinutes) || durationMinutes < 0 || durationMinutes > 1440) {
+    return { ...result, status: 'route_failed', reason: '缺少有效路线耗时；不能假定零分钟。' };
+  }
+  if ([preparation, buffer, extra, maxAdvance].some(value => !Number.isInteger(value) || value < 0 || value > 240)) {
+    return { ...result, reason: '准备、余量、额外准备和智能上限需为 0 到 240 的整数分钟。' };
+  }
+  if (!isTime(validUntil) || validUntil <= now || !isTime(updatedAt) || updatedAt > now) {
+    return { ...result, reason: '数据有效期或更新时间缺失、过期或无效。' };
+  }
+  const departAt = arrivalAt - (durationMinutes + buffer) * 60000;
+  const desiredWakeAt = departAt - (preparation + extra) * 60000;
+  if (!isTime(departAt) || !isTime(desiredWakeAt)) return { ...result, reason: '倒推后的时间超出有效范围。' };
+  const calculated = { ...result, desiredWakeAt, departAt, validUntil, updatedAt };
+  if (desiredWakeAt >= baseAlarmAt) return { ...calculated, reason: '无需提前，保留基础闹钟。' };
+  const wakeAt = Math.max(desiredWakeAt, baseAlarmAt - maxAdvance * 60000);
+  if (!isTime(wakeAt) || wakeAt <= now) return { ...calculated, reason: '建议叫醒时间已经错过，暂不创建过去闹钟。' };
+  const gapMinutes = Math.ceil((wakeAt - desiredWakeAt) / 60000);
+  return {
+    ...calculated, wakeAt: wakeAt < baseAlarmAt ? wakeAt : null, gapMinutes,
+    status: gapMinutes > 0 ? 'capped' : 'ready',
+    reason: gapMinutes > 0
+      ? `受用户智能提前上限限制，距满足到达目标仍差约 ${gapMinutes} 分钟。`
+      : '按提供的交通耗时、准备时间与到达余量倒推智能提前候选。',
+  };
+}
diff --git a/tests/alarmTiming.test.js b/tests/alarmTiming.test.js
new file mode 100644
index 0000000..36e568f
--- /dev/null
+++ b/tests/alarmTiming.test.js
@@ -0,0 +1,81 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { checkAlarmTiming } from '../src/alarmTiming.js';
+
+const settings = Object.freeze({
+  baseAlarmAt: Date.parse('2026-10-30T07:00:00+08:00'),
+  recheckAt: Date.parse('2026-10-30T05:30:00+08:00'),
+  fixedEnabled: true, smartEnabled: true, fixedMinutes: 30, maxAdvance: 60,
+  ambientEnabled: true, ambientOffset: 5, fallback: '保留基础闹钟',
+});
+
+test('两个模式和环境音一起计算最早发声时间', () => {
+  const result = checkAlarmTiming(settings);
+  assert.equal(result.ok, true);
+  assert.equal(result.earliestAlarmAt, Date.parse('2026-10-30T06:00:00+08:00'));
+  assert.equal(result.earliestSoundAt, Date.parse('2026-10-30T05:55:00+08:00'));
+  assert.deepEqual(result.issues, []);
+});
+
+test('固定量可以大于智能上限，并按固定量检查复查时间', () => {
+  const result = checkAlarmTiming({ ...settings, fixedMinutes: 90, recheckAt: Date.parse('2026-10-30T05:00:00+08:00') });
+  assert.equal(result.ok, true);
+  assert.equal(result.earliestSoundAt, Date.parse('2026-10-30T05:25:00+08:00'));
+});
+
+test('复查等于或晚于环境音开始时间均报告冲突，备用策略不能掩盖', () => {
+  for (const fallback of ['保留基础闹钟', '仅按固定模式']) {
+    const result = checkAlarmTiming({ ...settings, recheckAt: Date.parse('2026-10-30T05:55:00+08:00'), fallback });
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.some(issue => issue.code === 'recheck_too_late'));
+  }
+});
+
+test('仅固定模式也需要在发声前复查，关闭环境音不减偏移', () => {
+  const result = checkAlarmTiming({ ...settings, smartEnabled: false, ambientEnabled: false, recheckAt: Date.parse('2026-10-30T06:30:00+08:00') });
+  assert.equal(result.earliestSoundAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(result.ok, false);
+});
+
+test('仅智能给绑定固定的非阻断提醒，未开启固定不能选固定备用', () => {
+  const result = checkAlarmTiming({ ...settings, fixedEnabled: false });
+  assert.equal(result.ok, true);
+  assert.ok(result.warnings.some(issue => issue.code === 'smart_without_fixed'));
+  const invalid = checkAlarmTiming({ ...settings, fixedEnabled: false, fallback: '仅按固定模式' });
+  assert.equal(invalid.ok, false);
+  assert.ok(invalid.issues.some(issue => issue.code === 'fixed_fallback_disabled'));
+});
+
+test('无模式、非布尔开关、非法时间/分钟/备用设置均拒绝', () => {
+  for (const changes of [
+    { fixedEnabled: false, smartEnabled: false }, { fixedEnabled: 'true' },
+    { baseAlarmAt: null }, { recheckAt: '05:30' }, { fixedMinutes: -1 },
+    { maxAdvance: 241 }, { ambientOffset: 0 }, { ambientOffset: 61 },
+    { ambientEnabled: 'true' }, { fallback: '随便' },
+  ]) {
+    const result = checkAlarmTiming({ ...settings, ...changes });
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.length > 0);
+  }
+});
+
+test('未开启模式的旧分钟配置不参与，关闭环境音时也不验证旧偏移', () => {
+  const result = checkAlarmTiming({ ...settings, smartEnabled: false, maxAdvance: null, ambientEnabled: false, ambientOffset: null });
+  assert.equal(result.ok, true);
+  assert.equal(result.earliestSoundAt, Date.parse('2026-10-30T06:30:00+08:00'));
+});
+
+test('跨日最早发声必须与前一晚的复查时间比较', () => {
+  const result = checkAlarmTiming({ ...settings,
+    baseAlarmAt: Date.parse('2026-10-30T00:10:00+08:00'),
+    recheckAt: Date.parse('2026-10-29T22:00:00+08:00'),
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.earliestSoundAt, Date.parse('2026-10-29T23:05:00+08:00'));
+});
+
+test('检查不改变设置，重复结果一致', () => {
+  const before = structuredClone(settings);
+  assert.deepEqual(checkAlarmTiming(settings), checkAlarmTiming(settings));
+  assert.deepEqual(settings, before);
+});
diff --git a/tests/alarmWrite.test.js b/tests/alarmWrite.test.js
new file mode 100644
index 0000000..e632689
--- /dev/null
+++ b/tests/alarmWrite.test.js
@@ -0,0 +1,141 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { suggestAlarmWrite } from '../src/alarmWrite.js';
+
+const now = Date.parse('2026-10-30T05:00:00+08:00');
+const base = Object.freeze({ id: 'base-1', at: Date.parse('2026-10-30T07:00:00+08:00'), enabled: true, repeat: 'daily', label: '基础闹钟' });
+const candidate = Object.freeze({
+  baseAlarmAt: base.at, wakeAt: Date.parse('2026-10-30T06:30:00+08:00'),
+  validUntil: Date.parse('2026-10-30T05:15:00+08:00'), updatedAt: now,
+  status: 'ready', source: 'fixed', departAt: null, gapMinutes: null,
+  reason: '固定提前30分钟', executionState: 'suggested',
+});
+const mergeResult = Object.freeze({ action: 'suggest', status: 'ready', selectedMode: 'fixed', candidate });
+const input = Object.freeze({ alarms: Object.freeze([base]), baseAlarmId: base.id, commutePlanId: 'commute-1', mergeResult, now });
+const existing = Object.freeze({ id: 'primary-1', planKind: 'primary', commutePlanId: 'commute-1', baseAlarmId: base.id, baseAlarmAt: base.at, at: Date.parse('2026-10-30T06:40:00+08:00'), label: '我的提前闹钟', enabled: true, state: 'armed' });
+
+test('首次只返回创建补丁，不生成ID、不写入或修改基础闹钟', () => {
+  const result = suggestAlarmWrite(input);
+  assert.equal(result.action, 'create');
+  assert.equal(result.targetId, null);
+  assert.equal(result.patch.id, undefined);
+  assert.equal(result.patch.at, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(result.patch.planKind, 'primary');
+  assert.equal(result.patch.baseAlarmId, base.id);
+  assert.equal(result.patch.commutePlanId, 'commute-1');
+  assert.equal(result.patch.repeat, 'once');
+  assert.equal(input.alarms.length, 1);
+  assert.equal(base.at, Date.parse('2026-10-30T07:00:00+08:00'));
+});
+
+test('已有同一计划时复用原ID并保留用户名称', () => {
+  const result = suggestAlarmWrite({ ...input, alarms: [base, existing] });
+  assert.equal(result.action, 'update');
+  assert.equal(result.targetId, 'primary-1');
+  assert.equal(result.patch.at, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(result.patch.label, '我的提前闹钟');
+});
+
+test('同一补丁模拟保存后再次请求是noop，不追加第二个主要闹钟', () => {
+  const first = suggestAlarmWrite(input);
+  const saved = { ...first.patch, id: 'saved-1' };
+  const second = suggestAlarmWrite({ ...input, alarms: [base, saved] });
+  assert.equal(second.action, 'noop');
+  assert.equal(second.targetId, 'saved-1');
+  assert.equal(second.patch, null);
+  assert.equal(first.idempotencyKey, second.idempotencyKey);
+});
+
+test('无新候选时只保留，不删除旧计划', () => {
+  const result = suggestAlarmWrite({ ...input, alarms: [base, existing], mergeResult: { action: 'keep_existing', candidate: null } });
+  assert.equal(result.action, 'keep_existing');
+  assert.equal(result.patch, null);
+});
+
+test('已有同次且启用的更早主要闹钟不被延后', () => {
+  const result = suggestAlarmWrite({ ...input, alarms: [base, { ...existing, at: Date.parse('2026-10-30T06:00:00+08:00') }] });
+  assert.equal(result.action, 'keep_existing');
+  assert.equal(result.targetId, existing.id);
+  assert.equal(result.patch, null);
+});
+
+test('用户更换了基础闹钟ID时更新绑定，不把相同钟点误认作同一基础', () => {
+  const result = suggestAlarmWrite({ ...input, alarms: [base, {
+    ...existing, baseAlarmId: 'old-base', at: Date.parse('2026-10-30T06:00:00+08:00'),
+  }] });
+  assert.equal(result.action, 'update');
+  assert.equal(result.patch.baseAlarmId, 'base-1');
+});
+
+test('保存前再次检查新鲜度、未来时间、状态及基础时间匹配', () => {
+  for (const changes of [
+    { validUntil: now }, { wakeAt: now }, { wakeAt: base.at },
+    { baseAlarmAt: base.at + 86400000 }, { status: 'needs_confirmation' },
+  ]) {
+    const result = suggestAlarmWrite({ ...input, mergeResult: { ...mergeResult, candidate: { ...candidate, ...changes } } });
+    assert.equal(result.action, 'blocked');
+    assert.equal(result.patch, null);
+  }
+});
+
+test('基础不存在、关闭、归属非法或时间已改变时不写入', () => {
+  for (const changes of [
+    { alarms: [] }, { alarms: [{ ...base, enabled: false }] },
+    { alarms: [{ ...base, at: base.at + 60000 }] }, { alarms: [{ ...base, planKind: 'primary' }] },
+    { baseAlarmId: '' }, { commutePlanId: '' }, { now: null }, { alarms: null },
+  ]) {
+    assert.equal(suggestAlarmWrite({ ...input, ...changes }).action, 'blocked');
+  }
+});
+
+test('同计划多条主要闹钟、重复ID或未迁移归属的旧主要闹钟阻断', () => {
+  for (const alarms of [
+    [base, existing, { ...existing, id: 'primary-2' }],
+    [base, { ...base }],
+    [base, existing, { id: existing.id, at: base.at }],
+    [base, { id: 'legacy-1', planKind: 'primary', at: candidate.wakeAt }],
+  ]) {
+    const result = suggestAlarmWrite({ ...input, alarms });
+    assert.equal(result.action, 'blocked');
+    assert.equal(result.patch, null);
+  }
+});
+
+test('其他计划主要闹钟不被更新', () => {
+  const other = { ...existing, commutePlanId: 'other-plan' };
+  const result = suggestAlarmWrite({ ...input, alarms: [base, other] });
+  assert.equal(result.action, 'create');
+  assert.equal(result.targetId, null);
+  assert.equal(other.at, Date.parse('2026-10-30T06:40:00+08:00'));
+});
+
+test('正在响铃的主要闹钟不被重新设为armed', () => {
+  const result = suggestAlarmWrite({ ...input, alarms: [base, { ...existing, state: 'ringing' }] });
+  assert.equal(result.action, 'blocked');
+  assert.equal(result.patch, null);
+});
+
+test('刚到期或已过期但仍启用的主要闹钟等待调度处理，不重置成未来闹钟', () => {
+  for (const at of [now, now - 60000]) {
+    const result = suggestAlarmWrite({ ...input, alarms: [base, { ...existing, at }] });
+    assert.equal(result.action, 'blocked');
+    assert.equal(result.patch, null);
+  }
+});
+
+test('智能capped结果保留缺口，不能借保存伪称完整满足通勤', () => {
+  const result = suggestAlarmWrite({ ...input, mergeResult: {
+    ...mergeResult, status: 'capped', selectedMode: 'smart',
+    candidate: { ...candidate, status: 'capped', gapMinutes: 20, source: 'smart' },
+  } });
+  assert.equal(result.action, 'create');
+  assert.equal(result.patch.planStatus, 'capped');
+  assert.equal(result.patch.gapMinutes, 20);
+});
+
+test('重复计算一致且不改变任何输入记录', () => {
+  const args = Object.freeze({ ...input, alarms: Object.freeze([base, existing]) });
+  const before = structuredClone(args);
+  assert.deepEqual(suggestAlarmWrite(args), suggestAlarmWrite(args));
+  assert.deepEqual(args, before);
+});
diff --git a/tests/commuteFlow.test.js b/tests/commuteFlow.test.js
new file mode 100644
index 0000000..a6b8123
--- /dev/null
+++ b/tests/commuteFlow.test.js
@@ -0,0 +1,126 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { calculateFixedCandidate } from '../src/fixedAdvance.js';
+import { calculateSmartCandidate } from '../src/smartAdvance.js';
+import { mergeAdvanceCandidates } from '../src/mergeAdvance.js';
+import { checkAlarmTiming } from '../src/alarmTiming.js';
+import { suggestAlarmWrite } from '../src/alarmWrite.js';
+
+const sample = Object.freeze({
+  baseAlarmAt: Date.parse('2026-10-30T07:00:00+08:00'),
+  arrivalAt: Date.parse('2026-10-30T08:00:00+08:00'),
+  now: Date.parse('2026-10-30T05:00:00+08:00'),
+  updatedAt: Date.parse('2026-10-30T05:00:00+08:00'),
+  validUntil: Date.parse('2026-10-30T05:15:00+08:00'),
+  fixedEnabled: true, smartEnabled: true, fixedMinutes: 30, maxAdvance: 60,
+  durationMinutes: 60, preparation: 30, buffer: 10, extra: 10, weatherTriggered: true,
+});
+
+// 离线场景的接入层示例，不请求天气，也不执行实际保存。
+function calculate(changes = {}, previous) {
+  const args = { ...sample, ...changes };
+  const base = { id: 'base-1', at: args.baseAlarmAt, enabled: true, repeat: 'daily' };
+  const rawFixed = calculateFixedCandidate(args);
+  const fixedCandidate = rawFixed.status === 'ready'
+    ? { ...rawFixed, validUntil: args.validUntil, updatedAt: args.updatedAt } : rawFixed;
+  const smartCandidate = calculateSmartCandidate(args);
+  const merged = mergeAdvanceCandidates({ ...args, fixedCandidate, smartCandidate });
+  const alarms = previous ?? [base];
+  const operation = suggestAlarmWrite({ mergeResult: merged, alarms, baseAlarmId: base.id, commutePlanId: 'commute-1', now: args.now });
+  return { args, fixedCandidate, smartCandidate, merged, operation, alarms };
+}
+
+test('设置检查 → 两种候选 → 合并 → 单条创建建议，基础07:00仍独立', () => {
+  const timing = checkAlarmTiming({ ...sample, recheckAt: sample.now, ambientEnabled: true, ambientOffset: 5 });
+  assert.equal(timing.ok, true);
+  const flow = calculate();
+  assert.equal(flow.fixedCandidate.wakeAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(flow.smartCandidate.wakeAt, Date.parse('2026-10-30T06:10:00+08:00'));
+  assert.equal(flow.operation.action, 'create');
+  assert.equal(flow.operation.patch.at, Date.parse('2026-10-30T06:10:00+08:00'));
+  assert.equal(flow.alarms.length, 1);
+  assert.equal(flow.alarms[0].at, Date.parse('2026-10-30T07:00:00+08:00'));
+});
+
+test('固定或智能单独开启均能完成离线计算链路', () => {
+  const fixed = calculate({ smartEnabled: false });
+  assert.equal(fixed.operation.patch.at, Date.parse('2026-10-30T06:30:00+08:00'));
+  const smart = calculate({ fixedEnabled: false });
+  assert.equal(smart.operation.patch.at, Date.parse('2026-10-30T06:10:00+08:00'));
+});
+
+test('路线失败时固定仍可用，不要求高德先成功', () => {
+  const flow = calculate({ durationMinutes: null });
+  assert.equal(flow.smartCandidate.status, 'route_failed');
+  assert.equal(flow.merged.selectedMode, 'fixed');
+  assert.equal(flow.operation.action, 'create');
+  const onlySmart = calculate({ fixedEnabled: false, durationMinutes: null });
+  assert.equal(onlySmart.operation.action, 'keep_existing');
+});
+
+test('天气未知、未触发或数据过期不创建额外闹钟', () => {
+  for (const changes of [{ weatherTriggered: null }, { weatherTriggered: false }, { validUntil: sample.now }]) {
+    const flow = calculate(changes);
+    assert.equal(flow.operation.action, 'keep_existing');
+    assert.equal(flow.operation.patch, null);
+    assert.equal(flow.alarms.length, 1);
+  }
+});
+
+test('智能达到上限时保留缺口；固定更早时仍选固定', () => {
+  const smartOnly = calculate({ fixedEnabled: false, maxAdvance: 30 });
+  assert.equal(smartOnly.operation.patch.at, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(smartOnly.operation.patch.planStatus, 'capped');
+  assert.equal(smartOnly.operation.patch.gapMinutes, 20);
+  const both = calculate({ maxAdvance: 20 });
+  assert.equal(both.smartCandidate.gapMinutes, 30);
+  assert.equal(both.merged.selectedMode, 'fixed');
+  assert.equal(both.operation.patch.at, Date.parse('2026-10-30T06:30:00+08:00'));
+});
+
+test('智能上限0且没有固定时保留基础，不生成同时间重复铃', () => {
+  const flow = calculate({ fixedEnabled: false, maxAdvance: 0 });
+  assert.equal(flow.smartCandidate.gapMinutes, 50);
+  assert.equal(flow.operation.action, 'keep_existing');
+});
+
+test('模拟保存一次后重复计算无需新增，最终仍是一条基础加一条主要闹钟', () => {
+  const first = calculate();
+  const saved = { ...first.operation.patch, id: 'primary-1' };
+  const alarms = Object.freeze([Object.freeze(first.alarms[0]), Object.freeze(saved)]);
+  const second = calculate({}, alarms);
+  assert.equal(second.operation.action, 'noop');
+  assert.equal(second.operation.targetId, 'primary-1');
+  assert.equal(alarms.length, 2);
+  const unknown = calculate({ weatherTriggered: null }, alarms);
+  assert.equal(unknown.operation.action, 'keep_existing');
+  assert.equal(alarms[1].at, Date.parse('2026-10-30T06:10:00+08:00'));
+});
+
+test('页面恢复后先重算，也不能把尚未由调度处理的06:00旧铃延至06:30', () => {
+  const alarms = Object.freeze([
+    Object.freeze({ id: 'base-1', at: sample.baseAlarmAt, enabled: true }),
+    Object.freeze({ id: 'primary-1', planKind: 'primary', commutePlanId: 'commute-1',
+      baseAlarmId: 'base-1', baseAlarmAt: sample.baseAlarmAt,
+      at: Date.parse('2026-10-30T06:00:00+08:00'), enabled: true, state: 'armed' }),
+  ]);
+  const flow = calculate({ smartEnabled: false,
+    now: Date.parse('2026-10-30T06:10:00+08:00'), updatedAt: Date.parse('2026-10-30T06:10:00+08:00'),
+    validUntil: Date.parse('2026-10-30T06:25:00+08:00'),
+  }, alarms);
+  assert.equal(flow.merged.candidate.wakeAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(flow.operation.action, 'blocked');
+  assert.equal(flow.operation.patch, null);
+  assert.equal(alarms[1].at, Date.parse('2026-10-30T06:00:00+08:00'));
+});
+
+test('跨午夜计算、上限、合并和保存建议使用完整日期', () => {
+  const flow = calculate({
+    now: Date.parse('2026-10-29T22:00:00+08:00'), updatedAt: Date.parse('2026-10-29T22:00:00+08:00'),
+    validUntil: Date.parse('2026-10-29T22:15:00+08:00'),
+    baseAlarmAt: Date.parse('2026-10-30T00:30:00+08:00'), arrivalAt: Date.parse('2026-10-30T01:00:00+08:00'),
+  });
+  assert.equal(flow.operation.patch.at, Date.parse('2026-10-29T23:30:00+08:00'));
+  assert.equal(flow.operation.patch.baseAlarmAt, Date.parse('2026-10-30T00:30:00+08:00'));
+  assert.equal(flow.operation.patch.gapMinutes, 20);
+});
diff --git a/tests/fixedAdvance.test.js b/tests/fixedAdvance.test.js
new file mode 100644
index 0000000..0ac761d
--- /dev/null
+++ b/tests/fixedAdvance.test.js
@@ -0,0 +1,88 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { calculateFixedCandidate } from '../src/fixedAdvance.js';
+
+const baseAlarmAt = Date.parse('2026-10-30T07:00:00+08:00');
+const input = { baseAlarmAt, fixedEnabled: true, fixedMinutes: 30, weatherTriggered: true };
+
+test('不需要路线：基础 07:00，触发后固定提前到 06:30', () => {
+  const result = calculateFixedCandidate(input);
+  assert.equal(result.status, 'ready');
+  assert.equal(result.wakeAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(result.baseAlarmAt, baseAlarmAt);
+  assert.equal(result.source, 'fixed');
+  assert.equal(result.executionState, 'suggested');
+  assert.equal(result.departAt, null);
+  assert.equal(result.validUntil, null);
+  assert.equal(result.updatedAt, null);
+  assert.equal(result.gapMinutes, null);
+});
+
+test('关闭固定模式或者未触发天气时不生成候选', () => {
+  for (const changes of [{ fixedEnabled: false }, { weatherTriggered: false }]) {
+    const result = calculateFixedCandidate({ ...input, ...changes });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+    assert.equal(result.baseAlarmAt, baseAlarmAt);
+  }
+});
+
+test('天气未知或缺失时明确标记未知，不能当作未下雨', () => {
+  for (const weatherTriggered of [null, undefined]) {
+    const result = calculateFixedCandidate({ ...input, weatherTriggered });
+    assert.equal(result.status, 'weather_unknown');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('提前零分钟时不生成与基础闹钟重复的候选', () => {
+  const result = calculateFixedCandidate({ ...input, fixedMinutes: 0 });
+  assert.equal(result.status, 'unavailable');
+  assert.equal(result.wakeAt, null);
+});
+
+test('00:10 提前 30 分钟正确落在前一天 23:40', () => {
+  const result = calculateFixedCandidate({ ...input, baseAlarmAt: Date.parse('2026-10-30T00:10:00+08:00') });
+  assert.equal(result.wakeAt, Date.parse('2026-10-29T23:40:00+08:00'));
+});
+
+test('固定提前不受智能上限限制，240 分钟也能独立计算', () => {
+  const result = calculateFixedCandidate({ ...input, fixedMinutes: 240, maxAdvance: 10 });
+  assert.equal(result.status, 'ready');
+  assert.equal(result.wakeAt, Date.parse('2026-10-30T03:00:00+08:00'));
+});
+
+test('非法分钟数不生成候选，不把空值或字符串隐式转换为分钟', () => {
+  for (const fixedMinutes of [-1, 241, 1.5, NaN, Infinity, null, undefined, '30', '']) {
+    const result = calculateFixedCandidate({ ...input, fixedMinutes });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('非法基础时间不生成候选，毫秒时间戳不能误传为时钟文字', () => {
+  for (const baseAlarmAt of [null, undefined, NaN, Infinity, '07:00', '2026-10-30', 8640000000000001]) {
+    const result = calculateFixedCandidate({ ...input, baseAlarmAt });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+    assert.equal(result.baseAlarmAt, null);
+  }
+});
+
+test('非布尔触发值和开关不能通过真值判断意外叫醒用户', () => {
+  for (const changes of [{ weatherTriggered: 'false' }, { weatherTriggered: 60 }, { fixedEnabled: 'false' }, { fixedEnabled: 1 }]) {
+    const result = calculateFixedCandidate({ ...input, ...changes });
+    assert.notEqual(result.status, 'ready');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('重复计算结果一致，不修改输入或基础闹钟', () => {
+  const frozen = Object.freeze({ ...input });
+  const first = calculateFixedCandidate(frozen);
+  const second = calculateFixedCandidate(frozen);
+  assert.deepEqual(first, second);
+  assert.notEqual(first, second);
+  assert.deepEqual(frozen, input);
+  assert.equal(frozen.baseAlarmAt, Date.parse('2026-10-30T07:00:00+08:00'));
+});
diff --git a/tests/mergeAdvance.test.js b/tests/mergeAdvance.test.js
new file mode 100644
index 0000000..e4cf1ef
--- /dev/null
+++ b/tests/mergeAdvance.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeAdvanceCandidates } from '../src/mergeAdvance.js';
+
+const now = Date.parse('2026-10-30T05:00:00+08:00');
+const baseAlarmAt = Date.parse('2026-10-30T07:00:00+08:00');
+const fixedCandidate = Object.freeze({
+  baseAlarmAt, wakeAt: Date.parse('2026-10-30T06:30:00+08:00'),
+  status: 'ready', reason: '固定提前 30 分钟', source: 'fixed',
+  validUntil: Date.parse('2026-10-30T05:15:00+08:00'),
+  updatedAt: now, departAt: null, gapMinutes: null, executionState: 'suggested',
+});
+const smartCandidate = Object.freeze({
+  ...fixedCandidate, wakeAt: Date.parse('2026-10-30T06:10:00+08:00'),
+  departAt: Date.parse('2026-10-30T07:40:00+08:00'),
+  reason: '通勤耗时与准备时间倒推', source: 'smart',
+});
+const input = Object.freeze({ baseAlarmAt, now, fixedEnabled: true, smartEnabled: true, fixedCandidate, smartCandidate });
+
+test('两种模式取较早时间，只返回一个建议并保留基础时间', () => {
+  const result = mergeAdvanceCandidates(input);
+  assert.equal(result.action, 'suggest');
+  assert.equal(result.status, 'ready');
+  assert.equal(result.selectedMode, 'smart');
+  assert.equal(result.candidate.wakeAt, Date.parse('2026-10-30T06:10:00+08:00'));
+  assert.equal(result.candidate.baseAlarmAt, baseAlarmAt);
+  assert.equal(result.candidate.departAt, Date.parse('2026-10-30T07:40:00+08:00'));
+});
+
+test('固定候选更早时选固定，相同时间也稳定选固定', () => {
+  for (const wakeAt of [Date.parse('2026-10-30T06:00:00+08:00'), smartCandidate.wakeAt]) {
+    const result = mergeAdvanceCandidates({ ...input, fixedCandidate: { ...fixedCandidate, wakeAt } });
+    assert.equal(result.selectedMode, 'fixed');
+    assert.equal(result.candidate.wakeAt, wakeAt);
+  }
+});
+
+test('只开启一种模式时不使用另一模式更早的时间', () => {
+  const fixedOnly = mergeAdvanceCandidates({ ...input, smartEnabled: false });
+  assert.equal(fixedOnly.selectedMode, 'fixed');
+  assert.equal(fixedOnly.candidate.wakeAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  const smartOnly = mergeAdvanceCandidates({ ...input, fixedEnabled: false });
+  assert.equal(smartOnly.selectedMode, 'smart');
+});
+
+test('过期、缺少有效期或无效有效期的较早智能候选不能覆盖固定候选', () => {
+  for (const validUntil of [now - 1, now, null, undefined, NaN, Infinity, '2026-10-30T05:15:00+08:00', 8640000000000001]) {
+    const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, validUntil } });
+    assert.equal(result.selectedMode, 'fixed');
+  }
+});
+
+test('未知天气、路线失败、不可用和待确认状态均不参与合并', () => {
+  for (const status of ['weather_unknown', 'route_failed', 'unavailable', 'needs_confirmation', 'approval', undefined]) {
+    const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, status } });
+    assert.equal(result.selectedMode, 'fixed');
+  }
+});
+
+test('唤醒时间必须仍在未来且早于基础，不能生成延后或重复基础的闹钟', () => {
+  for (const wakeAt of [now - 1, now, baseAlarmAt, baseAlarmAt + 60000, null, NaN, Infinity, '06:10', 8640000000000001]) {
+    const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, wakeAt } });
+    assert.equal(result.selectedMode, 'fixed');
+  }
+});
+
+test('其他日期或其他基础时间的候选不能混入本次计划', () => {
+  const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, baseAlarmAt: baseAlarmAt + 86400000 } });
+  assert.equal(result.selectedMode, 'fixed');
+});
+
+test('没有有效候选时明确不更新，不用基础闹钟伪造新候选', () => {
+  for (const changes of [
+    { fixedEnabled: false, smartEnabled: false },
+    { fixedCandidate: null, smartCandidate: null },
+    { fixedCandidate: undefined, smartCandidate: undefined },
+    { fixedCandidate: { ...fixedCandidate, status: 'weather_unknown' }, smartCandidate: { ...smartCandidate, status: 'route_failed' } },
+  ]) {
+    const result = mergeAdvanceCandidates({ ...input, ...changes });
+    assert.equal(result.action, 'keep_existing');
+    assert.equal(result.candidate, null);
+    assert.equal(result.selectedMode, null);
+    assert.equal(result.status, 'unavailable');
+  }
+});
+
+test('非法公共时间或已经到期的基础闹钟不能生成候选', () => {
+  for (const changes of [
+    { now: undefined }, { now: null }, { now: NaN }, { now: Infinity }, { now: '05:00' },
+    { baseAlarmAt: null }, { baseAlarmAt: NaN }, { baseAlarmAt: 8640000000000001 },
+    { baseAlarmAt: now }, { baseAlarmAt: now - 1 },
+  ]) {
+    const result = mergeAdvanceCandidates({ ...input, ...changes });
+    assert.equal(result.action, 'keep_existing');
+    assert.equal(result.candidate, null);
+  }
+});
+
+test('字符串开关不能按真值开启模式', () => {
+  const result = mergeAdvanceCandidates({ ...input, fixedEnabled: 'true', smartEnabled: 'false' });
+  assert.equal(result.action, 'keep_existing');
+  assert.equal(result.candidate, null);
+});
+
+test('智能上限处理后的候选保留 capped 与缺口，不能伪装为完全足够', () => {
+  const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, status: 'capped', gapMinutes: 15 } });
+  assert.equal(result.selectedMode, 'smart');
+  assert.equal(result.status, 'capped');
+  assert.equal(result.candidate.status, 'capped');
+  assert.equal(result.candidate.gapMinutes, 15);
+});
+
+test('没有有效缺口的 capped 智能结果和 capped 固定结果不能作为可用候选', () => {
+  for (const gapMinutes of [null, undefined, 0, -1, NaN, Infinity, '15']) {
+    const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, status: 'capped', gapMinutes } });
+    assert.equal(result.selectedMode, 'fixed');
+  }
+  const result = mergeAdvanceCandidates({ ...input, smartEnabled: false, fixedCandidate: { ...fixedCandidate, status: 'capped', gapMinutes: 15 } });
+  assert.equal(result.candidate, null);
+});
+
+test('跨日候选按完整时间戳比较，不按钟面排序', () => {
+  const result = mergeAdvanceCandidates({
+    ...input,
+    now: Date.parse('2026-10-29T23:00:00+08:00'),
+    baseAlarmAt: Date.parse('2026-10-30T00:10:00+08:00'),
+    fixedCandidate: { ...fixedCandidate, baseAlarmAt: Date.parse('2026-10-30T00:10:00+08:00'), wakeAt: Date.parse('2026-10-29T23:40:00+08:00') },
+    smartCandidate: { ...smartCandidate, baseAlarmAt: Date.parse('2026-10-30T00:10:00+08:00'), wakeAt: Date.parse('2026-10-30T00:00:00+08:00') },
+  });
+  assert.equal(result.selectedMode, 'fixed');
+  assert.equal(result.candidate.wakeAt, Date.parse('2026-10-29T23:40:00+08:00'));
+});
+
+test('输出只是新建议，不能沿用输入的已保存或已同步状态', () => {
+  const result = mergeAdvanceCandidates({ ...input, smartCandidate: { ...smartCandidate, executionState: 'synced' } });
+  assert.equal(result.candidate.executionState, 'suggested');
+});
+
+test('不修改输入，重复计算一致；返回对象不与输入候选共用引用', () => {
+  const before = structuredClone(input);
+  const result = mergeAdvanceCandidates(input);
+  assert.deepEqual(input, before);
+  assert.deepEqual(result, mergeAdvanceCandidates(input));
+  assert.notEqual(result.candidate, smartCandidate);
+  result.candidate.wakeAt = 0;
+  assert.equal(smartCandidate.wakeAt, Date.parse('2026-10-30T06:10:00+08:00'));
+});
diff --git a/tests/smartAdvance.test.js b/tests/smartAdvance.test.js
new file mode 100644
index 0000000..a7c44ae
--- /dev/null
+++ b/tests/smartAdvance.test.js
@@ -0,0 +1,108 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { calculateSmartCandidate } from '../src/smartAdvance.js';
+
+const now = Date.parse('2026-10-30T05:00:00+08:00');
+const input = Object.freeze({
+  baseAlarmAt: Date.parse('2026-10-30T07:00:00+08:00'),
+  arrivalAt: Date.parse('2026-10-30T08:00:00+08:00'),
+  durationMinutes: 60, preparation: 30, buffer: 10, extra: 10,
+  maxAdvance: 60, smartEnabled: true, weatherTriggered: true,
+  validUntil: Date.parse('2026-10-30T05:15:00+08:00'), updatedAt: now, now,
+});
+
+test('按交通、准备、余量和雨雪准备倒推，不使用大模型计算时间', () => {
+  const result = calculateSmartCandidate(input);
+  assert.equal(result.status, 'ready');
+  assert.equal(result.wakeAt, Date.parse('2026-10-30T06:10:00+08:00'));
+  assert.equal(result.desiredWakeAt, Date.parse('2026-10-30T06:10:00+08:00'));
+  assert.equal(result.departAt, Date.parse('2026-10-30T06:50:00+08:00'));
+  assert.equal(result.gapMinutes, 0);
+  assert.equal(result.baseAlarmAt, input.baseAlarmAt);
+  assert.equal(result.source, 'smart');
+  assert.equal(result.executionState, 'suggested');
+});
+
+test('用户上限30分钟时只提前到06:30，明确还有20分钟缺口', () => {
+  const result = calculateSmartCandidate({ ...input, maxAdvance: 30 });
+  assert.equal(result.status, 'capped');
+  assert.equal(result.wakeAt, Date.parse('2026-10-30T06:30:00+08:00'));
+  assert.equal(result.gapMinutes, 20);
+});
+
+test('上限0时不生成重复基础的额外闹钟，但仍显示缺口', () => {
+  const result = calculateSmartCandidate({ ...input, maxAdvance: 0 });
+  assert.equal(result.status, 'capped');
+  assert.equal(result.wakeAt, null);
+  assert.equal(result.gapMinutes, 50);
+});
+
+test('无需提前的方案不生成延后闹钟', () => {
+  const result = calculateSmartCandidate({ ...input, durationMinutes: 0, preparation: 10, buffer: 0, extra: 0 });
+  assert.equal(result.status, 'unavailable');
+  assert.equal(result.wakeAt, null);
+});
+
+test('模式关闭和天气未触发不生成智能候选', () => {
+  for (const changes of [{ smartEnabled: false }, { smartEnabled: 'true' }, { weatherTriggered: false }]) {
+    const result = calculateSmartCandidate({ ...input, ...changes });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('未知天气或字符串触发值不按下雨处理', () => {
+  for (const weatherTriggered of [null, undefined, 'false', 60]) {
+    const result = calculateSmartCandidate({ ...input, weatherTriggered });
+    assert.equal(result.status, 'weather_unknown');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('缺失或非法路线耗时不能假装零分钟路线', () => {
+  for (const durationMinutes of [undefined, null, -1, 1441, 1.5, NaN, Infinity, '60']) {
+    const result = calculateSmartCandidate({ ...input, durationMinutes });
+    assert.equal(result.status, 'route_failed');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('非法设置分钟数不参与计算', () => {
+  for (const key of ['preparation', 'buffer', 'extra', 'maxAdvance']) {
+    for (const value of [-1, 241, 1.5, null, undefined, '30']) {
+      const result = calculateSmartCandidate({ ...input, [key]: value });
+      assert.equal(result.status, 'unavailable');
+      assert.equal(result.wakeAt, null);
+    }
+  }
+});
+
+test('过期、缺失有效期或未来更新时间不生成候选', () => {
+  for (const changes of [{ validUntil: now }, { validUntil: null }, { validUntil: Infinity }, { updatedAt: null }, { updatedAt: now + 1 }]) {
+    const result = calculateSmartCandidate({ ...input, ...changes });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('非法公共日期及已经错过的叫醒时间不生成过去闹钟', () => {
+  for (const changes of [{ baseAlarmAt: '07:00' }, { arrivalAt: null }, { arrivalAt: now }, { now: null }, { now: Date.parse('2026-10-30T06:10:00+08:00'), validUntil: input.baseAlarmAt }]) {
+    const result = calculateSmartCandidate({ ...input, ...changes });
+    assert.equal(result.status, 'unavailable');
+    assert.equal(result.wakeAt, null);
+  }
+});
+
+test('跨午夜正确倒推到前一天，输入不变且结果可重复', () => {
+  const args = Object.freeze({ ...input,
+    now: Date.parse('2026-10-29T22:00:00+08:00'), updatedAt: Date.parse('2026-10-29T22:00:00+08:00'),
+    validUntil: Date.parse('2026-10-29T22:15:00+08:00'),
+    baseAlarmAt: Date.parse('2026-10-30T00:30:00+08:00'), arrivalAt: Date.parse('2026-10-30T01:00:00+08:00'),
+  });
+  const before = structuredClone(args);
+  const result = calculateSmartCandidate(args);
+  assert.equal(result.wakeAt, Date.parse('2026-10-29T23:30:00+08:00'));
+  assert.equal(result.gapMinutes, 20);
+  assert.deepEqual(result, calculateSmartCandidate(args));
+  assert.deepEqual(args, before);
+});
